{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./oxlintrc.json"],
  "ignorePatterns": ["legacy", "test-fixtures"],
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      // the published files are JavaScript (Node doesn't strip types in node_modules), typed with JSDoc comments
      "files": ["plugins/**", "*.mjs"],
      "rules": {
        "unicorn-js/no-asterisk-prefix-in-documentation-comments": "off"
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "import-js/no-extraneous-dependencies": ["error", { "devDependencies": true }]
      }
    }
  ]
}
