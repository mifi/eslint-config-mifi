{
  "name": "@mifi/lint-config",
  "packageManager": "yarn@4.12.0",
  "version": "0.1.1",
  "description": "mifi's oxlint config (formerly eslint-config-mifi)",
  "repository": "git@github.com:mifi/eslint-config-mifi.git",
  "author": "Mikael Finstad <finstaden@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "files": [
    "oxlintrc.json",
    "plugins",
    "migrate.mjs",
    "migrateSource.mjs"
  ],
  "exports": {
    "./oxlintrc.json": "./oxlintrc.json"
  },
  "bin": {
    "mifi-lint-migrate": "migrate.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^79"
  },
  "peerDependencies": {
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~6.0.3"
  }
}
